{
  "main": "index.html",
  "logo": "logo.png",
  "pluginSetting": {
    "single": true,
    "height": 420
  },
  "features": [
    {
      "code": "convert",
      "explain": "进制转换（2/8/10/16 互转、位宽、字节序）",
      "cmds": [
        "进制转换",
        "进制",
        "radix",
        "base"
      ]
    },
    {
      "code": "hex",
      "explain": "十六进制 → 十进制/二进制/八进制",
      "cmds": [
        {
          "type": "regex",
          "label": "十六进制转换",
          "match": "/^0[xX][0-9a-fA-F][0-9a-fA-F_\\s]*$/",
          "minLength": 3,
          "maxLength": 200
        }
      ]
    },
    {
      "code": "bin",
      "explain": "二进制 → 十进制/十六进制/八进制",
      "cmds": [
        {
          "type": "regex",
          "label": "二进制转换",
          "match": "/^0[bB][01][01_\\s]*$/",
          "minLength": 3,
          "maxLength": 200
        }
      ]
    },
    {
      "code": "oct",
      "explain": "八进制 → 十进制/十六进制/二进制",
      "cmds": [
        {
          "type": "regex",
          "label": "八进制转换",
          "match": "/^0[oO][0-7][0-7_\\s]*$/",
          "minLength": 3,
          "maxLength": 200
        }
      ]
    }
  ]
}
